{
  "schema": "vine.browser-performance-environment",
  "schemaVersion": 1,
  "id": "windows-reference-environment-v1",
  "sampleIntervalMilliseconds": 1000,
  "minimumSampleCoverage": 0.85,
  "maximumSampleGapMilliseconds": 2500,
  "warmupSamples": 5,
  "cpu": {
    "maximumTotalPercent": 35,
    "maximumExternalPercent": 12.5,
    "consecutiveSamples": 3
  },
  "disk": {
    "maximumPhysicalBytesPerSecond": 33554432,
    "maximumBusyPercent": 70,
    "consecutiveSamples": 3
  },
  "updater": {
    "executableNames": [
      "googleupdate.exe",
      "googleupdater.exe",
      "microsoftedgeupdate.exe",
      "updater.exe"
    ],
    "pathFragments": [
      "\\google\\googleupdater\\",
      "\\google\\update\\",
      "\\microsoft\\edgeupdate\\"
    ]
  },
  "qos": {
    "invalidateOnPriorityClassChange": true,
    "invalidateOnPriorityBoostChange": true,
    "invalidateOnPowerThrottlingChange": true
  }
}
