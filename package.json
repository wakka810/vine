{
  "name": "vine-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run check:fast && npm run check:fixture-e2e",
    "check:fast": "npm run check:docs && npm run check:toolchain && npm run check:rust && npm run check:js && npm run check:engine && npm run check:windows-trace",
    "check:fixture-e2e": "npm run prepare:engine && npm run check:fixture-e2e:prepared",
    "check:fixture-e2e:prepared": "npm run check:runtime:entry && npm run check:runtime:cdecl && npm run check:runtime:callback && npm run check:runtime:outer-return && npm run check:runtime:entry-return && npm run check:runtime:stack-bootstrap && npm run check:runtime:bootstrap-fs-first-stop && npm run check:runtime:bootstrap-fs && npm run check:runtime:bootstrap-params-first-stop && npm run check:runtime:bootstrap-params && npm run check:runtime:memory-delta && npm run check:runtime:window-loader && npm run check:runtime:window-browser",
    "check:adapter": "npm run prepare:engine && npm run check:engine:adapter && npm run check:runtime:memory",
    "check:private-corpus": "node tools/check-private-corpus.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "check:toolchain": "node tools/run-toolchain-spike.mjs",
    "check:rust": "cargo fmt --all --check && cargo test --workspace --locked && cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "check:js": "node tools/check-js-syntax.mjs",
    "check:engine": "node tools/run-x86-engine-spike.mjs",
    "check:windows-trace": "node tools/test-windows-trace-summary.mjs",
    "check:engine:adapter": "node tools/run-v86-adapter-spike.mjs",
    "check:runtime:abi": "node tools/run-runtime-abi-slice.mjs",
    "check:runtime:memory": "node tools/run-runtime-memory-slice.mjs",
    "check:runtime:core": "npm run check:rust",
    "check:runtime:pe": "cargo test -p vine-core --test pe32_load_plan --locked",
    "check:runtime:memory-core": "cargo test -p vine-core --test guest_memory_ingress --locked",
    "check:runtime:materialization": "cargo test -p vine-core --test pe32_materialization --locked",
    "check:runtime:imports": "cargo test -p vine-core --test pe32_import_binding --locked",
    "check:runtime:entry": "node tools/run-runtime-v86-entry-slice.mjs",
    "check:runtime:cdecl": "node tools/run-runtime-v86-entry-slice.mjs --dispatch-add",
    "check:runtime:callback": "node tools/run-runtime-v86-entry-slice.mjs --dispatch-callback",
    "check:runtime:outer-return": "node tools/run-runtime-v86-entry-slice.mjs --dispatch-outer-return",
    "check:runtime:entry-return": "node tools/run-runtime-v86-entry-slice.mjs --dispatch-entry-return",
    "check:runtime:stack-bootstrap": "node tools/run-runtime-v86-entry-slice.mjs --dispatch-stack-bootstrap",
    "check:runtime:memory-delta": "node tools/run-runtime-v86-memory-delta.mjs",
    "check:runtime:bootstrap-fs-first-stop": "node tools/run-runtime-v86-bootstrap-fs-slice.mjs",
    "check:runtime:bootstrap-fs": "node tools/run-runtime-v86-bootstrap-fs-slice.mjs --install-process-environment",
    "check:runtime:bootstrap-params-first-stop": "node tools/run-runtime-v86-bootstrap-fs-slice.mjs --process-parameters-first-stop",
    "check:runtime:bootstrap-params": "node tools/run-runtime-v86-bootstrap-fs-slice.mjs --install-process-parameters",
    "check:runtime:bgi-first-trap": "node tools/run-runtime-v86-bgi-first-trap.mjs",
    "check:runtime:bgi-first-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --dispatch-system-time",
    "check:runtime:bgi-second-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --dispatch-process-id",
    "check:runtime:bgi-third-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --dispatch-thread-id",
    "check:runtime:bgi-fourth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --dispatch-tick-count",
    "check:runtime:bgi-fifth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --dispatch-performance-counter",
    "check:runtime:bgi-sixth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --dispatch-startup-info",
    "check:runtime:bgi-seventh-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --dispatch-heap-set-information",
    "check:runtime:bgi-eighth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --dispatch-heap-create",
    "check:runtime:bgi-ninth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --dispatch-module-handle",
    "check:runtime:bgi-tenth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --dispatch-get-proc-address",
    "check:runtime:bgi-eleventh-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --dispatch-get-proc-address-second",
    "check:runtime:window-loader": "node tools/run-runtime-window-loader-slice.mjs",
    "check:runtime:window-browser": "node tools/run-runtime-window-browser-slice.mjs",
    "serve:runtime:window-browser": "node tools/run-runtime-window-browser-slice.mjs --serve",
    "probe:runtime:pe": "cargo run --quiet --locked -p vine-pe-probe --",
    "prepare:engine": "node tools/prepare-v86-adapter.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "v86": "0.5.424"
  }
}
