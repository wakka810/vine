{
  "name": "vine-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run check:fast && npm run check:fixture-e2e",
    "check:fast": "npm run check:docs && npm run check:checkpoint-manifest && npm run check:toolchain && npm run check:rust && npm run check:js && npm run check:engine && npm run check:windows-trace",
    "check:fixture-e2e": "npm run prepare:engine && npm run check:fixture-e2e:prepared",
    "check:fixture-e2e:prepared": "npm run check:runtime:entry && npm run check:runtime:cdecl && npm run check:runtime:callback && npm run check:runtime:outer-return && npm run check:runtime:entry-return && npm run check:runtime:stack-bootstrap && npm run check:runtime:bootstrap-fs-first-stop && npm run check:runtime:bootstrap-fs && npm run check:runtime:bootstrap-params-first-stop && npm run check:runtime:bootstrap-params && npm run check:runtime:memory-delta && npm run check:runtime:memory-writeback && npm run check:runtime:window-loader && npm run check:runtime:window-browser && npm run check:runtime:browser-worker:prepared",
    "check:adapter": "npm run prepare:engine && npm run check:engine:adapter && npm run check:runtime:memory",
    "check:private-corpus": "node tools/check-private-corpus.mjs",
    "check:docs": "node tools/check-docs.mjs",
    "check:checkpoint-manifest": "node tools/test-runtime-checkpoint-manifest.mjs",
    "check:toolchain": "node tools/run-toolchain-spike.mjs",
    "check:rust": "cargo fmt --all --check && cargo test --workspace --locked && cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "check:js": "node tools/check-js-syntax.mjs",
    "check:engine": "node tools/run-x86-engine-spike.mjs",
    "check:windows-trace": "node tools/test-windows-trace-summary.mjs",
    "check:engine:adapter": "node tools/run-v86-adapter-spike.mjs",
    "check:runtime:abi": "node tools/run-runtime-abi-slice.mjs",
    "check:runtime:memory": "node tools/run-runtime-memory-slice.mjs",
    "check:runtime:core": "npm run check:rust",
    "check:runtime:pe": "cargo test -p vine-core --test pe32_load_plan --locked",
    "check:runtime:memory-core": "cargo test -p vine-core --test guest_memory_ingress --locked",
    "check:runtime:materialization": "cargo test -p vine-core --test pe32_materialization --locked",
    "check:runtime:imports": "cargo test -p vine-core --test pe32_import_binding --locked",
    "check:runtime:entry": "node tools/run-runtime-v86-entry-slice.mjs",
    "check:runtime:cdecl": "node tools/run-runtime-v86-entry-slice.mjs --dispatch-add",
    "check:runtime:callback": "node tools/run-runtime-v86-entry-slice.mjs --dispatch-callback",
    "check:runtime:outer-return": "node tools/run-runtime-v86-entry-slice.mjs --dispatch-outer-return",
    "check:runtime:entry-return": "node tools/run-runtime-v86-entry-slice.mjs --dispatch-entry-return",
    "check:runtime:stack-bootstrap": "node tools/run-runtime-v86-entry-slice.mjs --dispatch-stack-bootstrap",
    "check:runtime:memory-delta": "node tools/run-runtime-v86-memory-delta.mjs",
    "check:runtime:memory-writeback": "node tools/run-runtime-v86-memory-writeback.mjs",
    "check:runtime:bootstrap-fs-first-stop": "node tools/run-runtime-v86-bootstrap-fs-slice.mjs",
    "check:runtime:bootstrap-fs": "node tools/run-runtime-v86-bootstrap-fs-slice.mjs --install-process-environment",
    "check:runtime:bootstrap-params-first-stop": "node tools/run-runtime-v86-bootstrap-fs-slice.mjs --process-parameters-first-stop",
    "check:runtime:bootstrap-params": "node tools/run-runtime-v86-bootstrap-fs-slice.mjs --install-process-parameters",
    "check:runtime:bgi-first-trap": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-first-trap",
    "check:runtime:bgi-first-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-first-win32-call",
    "check:runtime:bgi-second-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-second-win32-call",
    "check:runtime:bgi-third-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-third-win32-call",
    "check:runtime:bgi-fourth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-fourth-win32-call",
    "check:runtime:bgi-fifth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-fifth-win32-call",
    "check:runtime:bgi-sixth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-sixth-win32-call",
    "check:runtime:bgi-seventh-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-seventh-win32-call",
    "check:runtime:bgi-eighth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-eighth-win32-call",
    "check:runtime:bgi-ninth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-ninth-win32-call",
    "check:runtime:bgi-tenth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-tenth-win32-call",
    "check:runtime:bgi-eleventh-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-eleventh-win32-call",
    "check:runtime:bgi-twelfth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-twelfth-win32-call",
    "check:runtime:bgi-thirteenth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-thirteenth-win32-call",
    "check:runtime:bgi-fourteenth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-fourteenth-win32-call",
    "check:runtime:bgi-fifteenth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-fifteenth-win32-call",
    "check:runtime:bgi-sixteenth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-sixteenth-win32-call",
    "check:runtime:bgi-seventeenth-win32-call": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-seventeenth-win32-call",
    "check:runtime:bgi-generic-runtime-reentry": "node tools/run-runtime-v86-bgi-first-trap.mjs --checkpoint bgi-seventeenth-win32-call --generic-runtime-reentry",
    "check:runtime:window-loader": "node tools/run-runtime-window-loader-slice.mjs",
    "check:runtime:window-browser": "node tools/run-runtime-window-browser-slice.mjs",
    "typecheck:runtime:browser-worker": "tsc -p browser/runtime-worker/tsconfig.json",
    "typecheck:runtime:v86-benchmark": "tsc -p browser/v86-benchmark/tsconfig.json",
    "build:runtime:browser-worker:prepared": "cargo build -p vine-runtime-wasm --target wasm32-unknown-unknown --release --locked && npm run typecheck:runtime:browser-worker && npm run typecheck:runtime:v86-benchmark && node tools/build-browser-runtime.mjs",
    "build:runtime:browser-worker": "npm run check:toolchain && npm run prepare:engine && npm run build:runtime:browser-worker:prepared",
    "check:runtime:browser-worker:prepared": "npm run build:runtime:browser-worker:prepared && node tools/run-browser-runtime-check.mjs",
    "check:runtime:browser-worker": "npm run check:toolchain && npm run prepare:engine && npm run check:runtime:browser-worker:prepared",
    "check:runtime:browser-worker:stress": "npm run build:runtime:browser-worker && node tools/run-browser-runtime-check.mjs --stress-ms 1800000",
    "check:runtime:v86-benchmark:prepared": "npm run build:runtime:browser-worker:prepared && node tools/run-v86-browser-benchmark.mjs",
    "check:runtime:v86-benchmark": "npm run check:toolchain && npm run prepare:engine && npm run check:runtime:v86-benchmark:prepared",
    "serve:runtime:window-browser": "node tools/run-runtime-window-browser-slice.mjs --serve",
    "serve:runtime:browser-worker": "npm run build:runtime:browser-worker && node tools/run-browser-runtime-check.mjs --serve",
    "probe:runtime:pe": "cargo run --quiet --locked -p vine-pe-probe --",
    "prepare:engine": "node tools/prepare-v86-adapter.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "lucide": "^1.24.0",
    "typescript": "^7.0.2",
    "v86": "0.5.424"
  }
}
